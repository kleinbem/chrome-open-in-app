{
  "manifest_version": 3,
  "name": "Open in App - Move Tabs to App Windows",
  "version": "1.5.1",
  "description": "Batch move open Google and web tabs into standalone app windows or dedicated windows with full toolbar support.",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "management",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open in App",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "open_all_in_app": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open matching tabs in app windows"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
