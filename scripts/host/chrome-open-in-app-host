#!/usr/bin/env python3
"""
Native Messaging Host for Open in App Chrome Extension.
Spawns genuine Chromium Browser::TYPE_APP windows with full navigation
buttons (Back, Forward, Reload) and dedicated taskbar/dock application icons.
"""

import sys
import os
import glob
import re
import json
import struct
import subprocess
from urllib.parse import urlparse

LOG_FILE = os.path.expanduser("~/.local/share/chrome-open-in-app.log")
DEBUG_ENABLED = os.environ.get("OPEN_IN_APP_DEBUG") == "1"

def log_debug(msg):
    if not DEBUG_ENABLED:
        return
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(str(msg) + "\n")
    except Exception:
        pass

def read_message():
    raw_length = sys.stdin.buffer.read(4)
    if not raw_length or len(raw_length) < 4:
        return None
    message_length = struct.unpack('@I', raw_length)[0]
    message = sys.stdin.buffer.read(message_length).decode('utf-8')
    return json.loads(message)

def send_message(msg):
    data = json.dumps(msg).encode('utf-8')
    sys.stdout.buffer.write(struct.pack('@I', len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()

def detect_chrome_context():
    """Detects --user-data-dir and --profile-directory from the calling Chrome process tree."""
    user_data_dir = None
    profile_dir = 'Default'
    current_pid = os.getppid()

    for step in range(10):
        try:
            with open(f'/proc/{current_pid}/cmdline', 'rb') as f:
                raw = f.read()
            cmdline_str = raw.decode('utf-8', errors='ignore')
            log_debug(f"Step {step}: pid={current_pid}, cmdline={cmdline_str[:120]}")
            if 'chrome' in cmdline_str:
                udd_match = re.search(r'--user-data-dir=([^ \0\t\r\n]+)', cmdline_str)
                if udd_match:
                    user_data_dir = udd_match.group(1)
                prof_match = re.search(r'--profile-directory=([^ \0\t\r\n]+)', cmdline_str)
                if prof_match:
                    profile_dir = prof_match.group(1)

                if user_data_dir:
                    return user_data_dir, profile_dir

            with open(f'/proc/{current_pid}/status', 'r') as f:
                for line in f:
                    if line.startswith('PPid:'):
                        current_pid = int(line.split()[1])
                        break
        except Exception as e:
            log_debug(f"Error reading /proc/{current_pid}: {e}")
            break

    return user_data_dir, profile_dir

def find_installed_pwa(target_url):
    """
    Finds if target_url matches any installed Chromium PWA on the system
    by inspecting ~/.local/share/applications/chrome-*-*.desktop.
    Returns (app_id, app_name) or (None, None).
    """
    if not target_url:
        return None, None
    try:
        parsed = urlparse(target_url)
        netloc = parsed.netloc.lower()
        if not netloc:
            return None, None

        desktop_files = glob.glob(os.path.expanduser('~/.local/share/applications/chrome-*-*.desktop'))
        matches = []
        for df in desktop_files:
            try:
                with open(df, 'r', encoding='utf-8', errors='ignore') as f:
                    content = f.read()
                app_id_match = re.search(r'--app-id=([a-z0-9]+)', content)
                if not app_id_match:
                    continue
                app_id = app_id_match.group(1)

                name_match = re.search(r'^Name=(.*)$', content, re.MULTILINE)
                name = name_match.group(1) if name_match else ''

                # Check shortcut URLs
                shortcut_urls = re.findall(r'--app-launch-url-for-shortcuts-menu-item=(https?://[^ \n\"\']+)', content)
                for u in shortcut_urls:
                    if urlparse(u).netloc.lower() == netloc:
                        return app_id, name

                # Match by domain name keyword (e.g. youtube, chatgpt, claude)
                domain_prefix = netloc.replace('www.', '').split('.')[0]
                if domain_prefix and len(domain_prefix) > 2 and domain_prefix.lower() in name.lower():
                    matches.append((app_id, name))
            except Exception:
                continue

        if matches:
            return matches[0]
    except Exception:
        pass

    return None, None

def main():
    log_debug("=== chrome-open-in-app-host started ===")
    msg = read_message()
    if not msg or 'url' not in msg:
        log_debug(f"Invalid message received: {msg}")
        send_message({'success': False, 'error': 'No URL provided'})
        return

    url = msg['url']
    app_id = msg.get('appId')
    user_data_dir = msg.get('userDataDir')
    profile_dir = msg.get('profileDir')

    # Detect calling Chrome environment if not explicitly provided
    detected_user_data_dir, detected_profile_dir = detect_chrome_context()
    log_debug(f"Detected context: user_data_dir={detected_user_data_dir}, profile_dir={detected_profile_dir}")
    if not user_data_dir and detected_user_data_dir:
        user_data_dir = detected_user_data_dir
    if not profile_dir and detected_profile_dir:
        profile_dir = detected_profile_dir

    # Detect installed PWA if appId not explicitly supplied
    if not app_id:
        pwa_id, pwa_name = find_installed_pwa(url)
        if pwa_id:
            app_id = pwa_id
            log_debug(f"Matched PWA '{pwa_name}' with ID: {pwa_id}")

    # Construct the launch command
    chrome_bin = 'google-chrome-stable'
    cmd = [chrome_bin]
    if user_data_dir:
        cmd.append(f'--user-data-dir={user_data_dir}')
    if profile_dir:
        cmd.append(f'--profile-directory={profile_dir}')

    if app_id:
        cmd.append(f'--app-id={app_id}')
    else:
        cmd.append(f'--app={url}')

    log_debug(f"Executing command: {' '.join(cmd)}")
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        log_debug(f"Process returncode={proc.returncode}, stdout={proc.stdout.strip()}, stderr={proc.stderr.strip()}")
        send_message({
            'success': True,
            'launched': url,
            'appId': app_id,
            'isPwa': bool(app_id)
        })
    except Exception as e:
        log_debug(f"Process execution error: {e}")
        send_message({'success': False, 'error': str(e)})

if __name__ == '__main__':
    main()
